# Discord Webhook URLs (for local testing)
# Get these from: Server Settings → Integrations → Webhooks → New Webhook
# KEEP THESE SECRET - anyone with these URLs can post to your channels

# KM channel webhook
DISCORD_WEBHOOK_URL_KM=https://discord.com/api/webhooks/YOUR_KM_WEBHOOK_ID/YOUR_KM_WEBHOOK_TOKEN

# UK channel webhook
DISCORD_WEBHOOK_URL_UK=https://discord.com/api/webhooks/YOUR_UK_WEBHOOK_ID/YOUR_UK_WEBHOOK_TOKEN

# Note: In production (GitHub Actions), the workflows read from their respective
# environment secrets. Locally, use --channel flag to pick which webhook to use:
#   bun run remind -- --channel=km --dry-run
#   bun run remind -- --channel=uk --dry-run
