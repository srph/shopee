# --- Node / TypeScript ---
node_modules/
dist/

# TypeScript build cache
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage / reports
coverage/
*.lcov
.nyc_output/

# Runtime / tool caches
.cache/
.eslintcache
.parcel-cache/
.turbo/
.next/
.nuxt/
.vite/
.vitest/
.rollup.cache/

# Dependency manager artifacts (don't commit the env, do commit lockfiles)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/

# Environment variables (keep a .env.example committed)
.env
.env.*
!.env.example
!.env.sample

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*.swn
*.tmp
*.temp

# Cursor (workspace-local)
.cursor/

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Misc ---
*.pid
*.seed
*.pid.lock

# Node runtime misc
.npm/
.node_repl_history

# direnv
.direnv/
.envrc
