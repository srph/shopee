{
  "name": "shopee-sale-reminder",
  "version": "1.0.0",
  "description": "Discord bot that reminds channel of monthly Shopee N.N sales",
  "main": "src/remind.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "remind:km": "bun run src/remind.ts --channel=km",
    "remind:uk": "bun run src/remind.ts --channel=uk",
    "remind:km:dry": "bun run src/remind.ts --channel=km --dry-run",
    "remind:uk:dry": "bun run src/remind.ts --channel=uk --dry-run"
  },
  "keywords": [
    "discord",
    "shopee",
    "reminder",
    "bot"
  ],
  "author": "Kier",
  "license": "MIT",
  "dependencies": {
    "luxon": "^3.4.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0"
  }
}
